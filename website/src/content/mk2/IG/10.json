{
  "page_id": "IG-10",
  "section_header": "IGNITION SYSTEM — Distributor",
  "title": "ADJUST IGNITION TIMING",
  "content": [
    {
      "type": "diagram",
      "index": 1,
      "description": "Illustration showing the check connector location on the engine, with a hand pointing to it",
      "labels": [
        "Check Connector"
      ],
      "bbox": {
        "top": 3,
        "left": 3,
        "width": 38,
        "height": 18
      },
      "reference_number": "#0715"
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        {
          "letter": "a",
          "text": "Connect a timing light to the engine."
        },
        {
          "letter": "b",
          "text": "Start the engine and run it at idle."
        },
        {
          "letter": "c",
          "text": "Short circuit the terminals of the check connector T and E1"
        }
      ]
    },
    {
      "type": "diagram",
      "index": 2,
      "description": "Illustration showing the timing marks on the crankshaft pulley with a timing light being used to check alignment",
      "labels": [
        "10° mark on pulley",
        "Timing light"
      ],
      "bbox": {
        "top": 22,
        "left": 3,
        "width": 38,
        "height": 18
      },
      "reference_number": "#0716"
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        {
          "letter": "d",
          "text": "Using a timing light, slowly turn the distributor until the timing mark on the crankshaft pulley is aligned with the 10° mark. Tighten the distributor bolt."
        }
      ]
    },
    {
      "type": "text",
      "text": "Ignition timing: 10° BTDC@ (T and E1)"
    },
    {
      "type": "torque_spec",
      "component": "Distributor bolt",
      "value": "140 kg-cm (10 ft-lb, 14 N·m)"
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        {
          "letter": "e",
          "text": "Unshort the check connector."
        }
      ]
    }
  ]
