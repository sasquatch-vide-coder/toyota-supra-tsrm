        "width": 38,
        "height": 23
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "6. ADJUST BRAKE PEDAL (See page BR-6)"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "7. PERFORM OPERATIONAL CHECK"
    },
    {
