    {
      "type": "heading",
      "level": 2,
      "text": "DISCONNECT AND CONNECT HOSE AND TUBE"
    },
    {
      "type": "diagram",
      "index": 1,
      "description": "Diagram showing brake hose, tube, and clip assembly with labels pointing to each component",
      "labels": [
        "Tube",
        "Clip",
        "Hose"
      ],
      "bbox": {
        "top": 5,
        "left": 2,
        "width": 38,
        "height": 20
      }
    },
    {
      "type": "heading",
      "level": 3,
      "text": "1. DISCONNECT HOSE AND TUBE"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Disconnect the clip.",
        "(b) Using a wrench to hold the hose and SST to hold the tube, disconnect the tube and hose."
      ]
    },
    {
      "type": "part_number",
      "label": "SST",
      "number": "09751-36011",
      "description": ""
    },
    {
      "type": "diagram",
      "index": 2,
      "description": "Diagram showing the use of SST (Special Service Tool) and wrench to disconnect brake hose and tube",
      "labels": [
        "SST"
      ],
      "bbox": {
        "top": 25,
        "left": 2,
        "width": 38,
        "height": 20
      }
    },
    {
      "type": "heading",
      "level": 3,
      "text": "2. CONNECT HOSE AND TUBE"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Connect the hose and tube by hand.",
        "(b) Using a wrench to hold the hose and SST to hold the tube, torque the connection."
      ]
    },
    {
      "type": "part_number",
      "label": "SST",
      "number": "09751-36011",
      "description": ""
    },
    {
      "type": "torque_spec",
      "component": "Hose and tube connection",
      "value": "155 kg·cm (11 ft·lb, 15 N·m)"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(c) Install a new hose clip."
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "INSPECTION OF BRAKE HOSES AND TUBES"
    },
    {
      "type": "diagram",
      "index": 3,
      "description": "Two diagrams showing cross-sectional views of brake hoses and tubes for inspection purposes",
      "labels": [],
      "bbox": {
        "top": 46,
        "left": 2,
        "width": 38,
        "height": 25
      }
    },
    {
      "type": "heading",
      "level": 3,
      "text": "1. INSPECT BRAKE HOSES"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Inspect the hose for damage, cracks or swelling.",
        "(b) Inspect the threads for damage."
      ]
    },
    {
      "type": "heading",
      "level": 3,
      "text": "2. INSPECT BRAKE TUBES"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Inspect the tube for damage, cracks, dents or corrosion.",
        "(b) Inspect the threads for damage."
      ]
    }
  ]
