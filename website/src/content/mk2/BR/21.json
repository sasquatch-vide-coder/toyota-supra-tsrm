        }
      ]
    },
    {
      "type": "diagram",
      "index": 3,
      "description": "Illustration showing installation of brake pads with anti-squeal shims on both sides",
      "labels": [],
      "bbox": {
        "top": 47,
        "left": 3,
        "width": 37,
        "height": 20
      }
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        {
          "number": "8",
          "title": "INSTALL NEW PADS AND NEW ANTI-SQUEAL SHIM",
          "substeps": [
            {
              "letter": "a",
              "text": "Install the pads onto each spring.",
              "note": "Install the outside pad so the wear indicator is at the bottom side."
            }
          ]
        }
      ]
    },
    {
      "type": "caution",
      "text": "Do not allow oil or grease to touch the rubbing face."
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        {
          "substeps": [
            {
              "letter": "b",
              "text": "Install the anti-squeal shim toward the outside of the pad."
            }
          ]
        }
      ]
    },
    {
      "type": "diagram",
      "index": 4,
      "description": "Illustration showing lowering of the brake cylinder onto the brake pads",
