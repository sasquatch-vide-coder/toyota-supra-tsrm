{
  "page_id": "BR-25",
  "section_header": "BRAKE SYSTEM — Rear Brake",
  "title": "BRAKE SYSTEM — Rear Brake",
  "content": [
    {
      "type": "diagram",
      "index": 1,
      "description": "Illustration showing installation of main pin boot on rear brake assembly with arrow pointing to boot location",
      "labels": [],
      "bbox": {
        "top": 5,
        "left": 1,
        "width": 38,
        "height": 30
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "4. INSTALL MAIN PIN BOOT"
    },
    {
      "type": "text",
      "text": "Using a 21-mm socket wrench, press in the boot."
    },
    {
      "type": "diagram",
      "index": 2,
      "description": "Illustration showing hands installing dust boot and sliding bushing into brake boot",
      "labels": [],
      "bbox": {
        "top": 33,
        "left": 1,
        "width": 38,
        "height": 30
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "5. INSTALL DUST BOOT AND SLIDING BUSHING"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Install the dust boot.",
        "(b) Install the bushing into the boot facing the flange toward the inside."
      ]
    },
    {
      "type": "notice",
      "text": "NOTE: Be careful that the seal does not fold under."
    },
    {
      "type": "heading",
      "level": 1,
      "text": "INSTALLATION OF CYLINDER"
    },
    {
      "type": "text",
      "text": "(See page BR-20)"
    },
    {
      "type": "text",
      "text": "SEE REAR BRAKE REPLACEMENT OF BRAKE PADS BR-20"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "1. INSTALL FOLLOWING PARTS:"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Pad support plate",
        "(b) Pad guide plates",
        "(c) Anti-rattle springs",
        "(d) Brake pads",
        "(e) Anti-squeal shim"
      ]
    },
    {
      "type": "diagram",
      "index": 3,
      "description": "Illustration showing hands installing cylinder onto brake assembly",
      "labels": [],
      "bbox": {
        "top": 64,
        "left": 1,
        "width": 38,
        "height": 20
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "2. INSTALL CYLINDER"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Install the cylinder onto the main pin.",
        "(b) Insert the cylinder installation bolt into the cylinder body.",
        "(c) Install the cylinder over the brake pads."
      ]
    },
    {
      "type": "notice",
      "text": "NOTE: Make sure that the boot end is installed into the groove of the main pin."
    },
    {
      "type": "heading",
      "level": 2,
      "text": "3. TORQUE CYLINDER INSTALLATION BOLT"
    },
    {
      "type": "text",
      "text": "Torque the bolt."
    },
    {
      "type": "torque_spec",
      "component": "Cylinder installation bolt",
      "value": "200 kg-cm (14 ft-lb, 20 N·m)"
    },
    {
      "type": "diagram",
      "index": 4,
      "description": "Illustration showing connection of brake line to cylinder on rear brake assembly",
      "labels": [
        "BR00625"
      ],
      "bbox": {
        "top": 84,
        "left": 1,
        "width": 38,
        "height": 20
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "4. CONNECT BRAKE LINE"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Connect the brake hose to the cylinder.",
        "(b) Using SST, connect brake hose to the brake tube. SST 09751-36011"
      ]
    },
    {
      "type": "torque_spec",
      "component": "Brake hose to cylinder",
      "value": "235 kg-cm (17 ft-lb, 23 N·m)"
    },
    {
      "type": "torque_spec",
      "component": "Brake hose to brake tube",
      "value": "155 kg-cm (11 ft-lb, 15 N·m)"
    },
    {
      "type": "part_number",
      "label": "SST",
      "number": "09751-36011",
      "description": ""
    },
    {
      "type": "heading",
      "level": 2,
      "text": "5. FILL BRAKE RESERVOIR WITH BRAKE FLUID AND BLEED BRAKE SYSTEM (See page BR-7)"
    }
  ]
}
