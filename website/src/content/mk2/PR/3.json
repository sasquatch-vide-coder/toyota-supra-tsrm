      "bbox": {
        "top": 75,
        "left": 2,
        "width": 36,
        "height": 18
      }
    },
    {
      "type": "text",
      "text": "(a) Remove the center bearing mounting bolts."
    },
    {
      "type": "text",
      "text": "(b) Pull out the propeller shaft from the transmission."
    },
    {
      "type": "text",
      "text": "(c) Insert SST in the transmission to prevent oil leakage."
    },
