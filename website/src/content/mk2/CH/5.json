      "items": [
        {
          "number": "1.",
          "text": "DISCONNECT CABLE FROM NEGATIVE TERMINAL OF BATTERY"
        },
        {
          "number": "2.",
          "text": "DISCONNECT WIRING FROM ALTERNATOR",
          "subitems": [
            "(a) Disconnect the connector from the alternator.",
            "(b) Remove the nut and wire from the alternator."
          ]
        },
        {
          "number": "3.",
          "text": "REMOVE ALTERNATOR DRIVE BELT",
          "details": "Loosen the alternator pivot, adjusting lock and adjusting bolts and remove the alternator drive belt."
        },
        {
          "number": "4.",
          "text": "REMOVE ALTERNATOR",
          "subitems": [
            "(a) Remove the pivot and adjusting lock bolts.",
            "(b) Remove the alternator."
          ]
        }
      ]
