{
  "page_id": "EM-39",
  "section_header": "ENGINE MECHANICAL — Cylinder Block",
  "title": "ENGINE MECHANICAL — Cylinder Block",
  "content": [
    {
      "type": "diagram",
      "index": 1,
      "description": "Illustration showing the upper engine compartment with focus on various wire and cable connections at the cylinder head area",
      "labels": [
        "EM140"
      ],
      "bbox": {
        "top": 5,
        "left": 5,
        "width": 45,
        "height": 22
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "8. DISCONNECT FOLLOWING WIRES AND CABLES:"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Ground strap from the cylinder head",
        "(b) Oxygen sensor wire",
        "(c) Oil pressure sending unit wire",
        "(d) Alternator wires",
        "(e) High-tension cord from the ignition coil",
        "(f) Distributor connector",
        "(g) Water temp. sending unit wire",
        "(h) Temp. switch wire (for A/T)",
        "(i) Starter wires",
        "(j) ECT connectors",
        "(k) Solenoid resistor wire connector",
        "(l) Knock sensor wire connector"
      ]
    },
    {
      "type": "diagram",
      "index": 2,
      "description": "Illustration showing the engine compartment focusing on hose connections and vacuum lines",
      "labels": [
        "EM141"
      ],
      "bbox": {
        "top": 27,
        "left": 5,
        "width": 45,
        "height": 22
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "9. DISCONNECT FOLLOWING HOSES:"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Brake booster vacuum hose from the air intake chamber.",
        "(b) Actuator vacuum hose from the air intake chamber (with cruise control system).",
        "(c) EGR valve vacuum hose."
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "10. DISCONNECT TWO HEATER HOSES"
    },
    {
      "type": "diagram",
      "index": 3,
      "description": "Illustration showing the EFI wire harness location and removal from the cowl panel area",
      "labels": [
        "EFI Wire Harness",
        "EM142"
      ],
      "bbox": {
        "top": 49,
        "left": 5,
        "width": 45,
        "height": 22
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "11. DISCONNECT EFI WIRE HARNESS FROM ECU"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Remove the glove box.",
        "(b) Remove the computer.",
        "(c) Disconnect the three connectors.",
        "(d) Pull out the EFI wire harness from cowl panel."
      ]
    },
    {
      "type": "diagram",
      "index": 4,
      "description": "Illustration showing the fan shroud and fluid coupling with bolts and nuts marked for removal",
      "labels": [
        "EM143"
      ],
      "bbox": {
        "top": 71,
        "left": 5,
        "width": 45,
        "height": 22
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "12. REMOVE FAN SHROUD AND FLUID COUPLING"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Remove the radiator upper hose.",
        "(b) Remove the four shroud bolts and the four coupling set nuts.",
        "(c) Remove the shroud with the coupling."
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "13. REMOVE ENGINE UNDERCOVER"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "14. REMOVE RADIATOR"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Remove the radiator lower hose.",
        "(b) Disconnect the two oil cooler hoses (for A/T).",
        "(c) Disconnect the coolant reservoir hose.",
        "(d) Remove the two radiator mounting bolts and radiator."
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "15. REMOVE COOLANT RESERVOIR TANK"
    }
  ]
}
