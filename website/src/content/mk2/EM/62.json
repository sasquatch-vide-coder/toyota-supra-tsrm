{
  "page_id": "EM-62",
  "section_header": "ENGINE MECHANICAL — Cylinder Block",
  "title": "ENGINE MECHANICAL — Cylinder Block",
  "content": [
    {
      "type": "heading",
      "level": 2,
      "text": "10. INSTALL COOLANT RESERVOIR TANK"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "11. INSTALL RADIATOR"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Install the radiator and the two mounting bolts.",
        "(b) Connect the coolant receiver tube.",
        "(c) Connect the two oil cooler hose. (for A/T)",
        "(d) Install the radiator lower hose."
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "12. INSTALL FAN SHROUD AND FLUID COUPLING"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "13. INSTALL AIR CLEANER CASE, AIR FLOW METER AND AIR INTAKE CONNECTOR PIPE"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "14. CONNECT EFI WIRE HARNESS TO ECU"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "15. CONNECT TWO HEATER HOSES TO BLOCK AND CYLINDER HEAD"
    },
    {
      "type": "diagram",
      "index": 1,
      "description": "Top view of engine showing vacuum hose connections to intake manifold and brake booster area",
      "labels": [],
      "bbox": {
        "top": 40,
        "left": 2,
        "width": 40,
        "height": 18
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "16. CONNECT FOLLOWING HOSES:"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Brake booster vacuum hose to the intake manifold",
        "(b) Actuator vacuum hose to the intake manifold (with cruise control system)",
        "(c) EGR valve vacuum hose"
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "17. CONNECT FOLLOWING WIRES AND CABLES:"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Ground to the cylinder head",
        "(b) Oxygen sensor wire",
        "(c) Oil pressure sending unit wire",
        "(d) ECT connectors",
        "(e) High-tension cord from the ignition coil",
        "(f) Distributor connector",
        "(g) Water temp. sending unit wire",
        "(h) Temp. switch wire (for A/T)",
        "(i) Solenoid resistor wire connector",
        "(j) Knock sensor wire connector"
      ]
    },
    {
      "type": "diagram",
      "index": 2,
      "description": "Side view showing distributor and ignition coil area with wire connections",
      "labels": [],
      "bbox": {
        "top": 58,
        "left": 2,
        "width": 40,
        "height": 18
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "18. INSTALL ACCELERATOR AND ACTUATOR CABLE BRACKET"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "19. INSTALL THROTTLE CABLE BRACKET (for A/T)"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "20. FILL WITH COOLANT"
    },
    {
      "type": "text",
      "text": "Close the radiator and engine drain cocks and fill with coolant."
    },
    {
      "type": "diagram",
      "index": 3,
      "description": "Engine compartment view showing accelerator cable bracket and throttle cable installation area",
      "labels": [],
      "bbox": {
        "top": 76,
        "left": 2,
        "width": 40,
        "height": 18
      }
    },
