{
  "page_id": "EM-11",
  "section_header": "ENGINE MECHANICAL — Timing Belt",
  "title": "CHECK TIMING BELT TENSION / REMOVAL OF TIMING BELT",
  "content": [
    {
      "type": "diagram",
      "index": 1,
      "description": "Illustration showing hands turning both intake and exhaust camshaft pulleys inward simultaneously",
      "labels": [
        "EM10a"
      ],
      "bbox": {
        "top": 5,
        "left": 5,
        "width": 40,
        "height": 20
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "10. CHECK TIMING BELT TENSION"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Turn both the intake and exhaust camshaft pulleys inward at the same time to slacken the timing belt at position A."
      ]
    },
    {
      "type": "torque_spec",
      "component": "Turning torque",
      "value": "200 kg·cm (14 ft·lb, 20 N·m)"
    },
    {
      "type": "diagram",
      "index": 2,
      "description": "Illustration showing measurement of timing belt deflection between two pulleys with 2-3 kg force applied",
      "labels": [
        "2 - 3 kg",
        "EM10b"
      ],
      "bbox": {
        "top": 26,
        "left": 5,
        "width": 40,
        "height": 20
      }
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(b) Measure the timing belt tension as shown."
      ]
    },
    {
      "type": "table",
      "caption": "Belt deflection at 2 — 3 kg (4.4 — 6.6 lb, 20 — 29 N):",
      "headers": [
        "Condition",
        "Deflection"
      ],
      "rows": [
        [
          "Cold Used belt",
          "5 — 7 mm (0.20 — 0.28 in.)"
        ],
        [
          "New belt",
          "4 — 6 mm (0.16 — 0.24 in.)"
        ],
        [
          "Hot (Reference)",
          "3 — 5 mm (0.12 — 0.20 in.)"
        ]
      ]
    },
    {
      "type": "diagram",
      "index": 3,
      "description": "Illustration showing adjustment of idler pulley to correct timing belt tension",
      "labels": [
        "EM10c"
      ],
      "bbox": {
        "top": 52,
        "left": 5,
        "width": 40,
        "height": 20
      }
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(c) If the measurement is not within specification, adjust with the idler pulley."
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "11. INSTALL NO. 3 TIMING BELT COVER"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "12. INSTALL OIL FILLER CAP AND CYLINDER HEAD COVER OF EXHAUST SIDE"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "13. INSTALL AIR INTAKE CONNECTOR"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "14. INSTALL NO.2 FAN SHROUD"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "15. CONNECT CABLE TO NEGATIVE TERMINAL OF BATTERY"
    },
    {
      "type": "heading",
      "level": 1,
      "text": "REMOVAL OF TIMING BELT"
    },
    {
      "type": "text",
      "text": "(See page EM-7)"
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        "DISCONNECT CABLE FROM NEGATIVE TERMINAL OF BATTERY",
        "DRAIN COOLANT",
        "REMOVE AIR CLEANER CASE"
      ]
    }
  ]
}
