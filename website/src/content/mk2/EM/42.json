{
  "page_id": "EM-42",
  "section_header": "ENGINE MECHANICAL — Cylinder Block",
  "title": "DISASSEMBLY OF CYLINDER BLOCK",
  "content": [
    {
      "type": "text",
      "text": "(See page EM-38)"
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        "REMOVE CLUTCH COVER AND DISC",
        "REMOVE FLYWHEEL OR DRIVE PLATE AND REAR END PLATE",
        "INSTALL ENGINE STAND FOR DISASSEMBLY"
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "4. REMOVE CYLINDER HEAD ASSEMBLY"
    },
    {
      "type": "diagram",
      "index": 1,
      "description": "Illustration showing the disconnection of No. 1 water by-pass hose from the water by-pass pipe on the engine block",
      "labels": [
        "EM-665"
      ],
      "bbox": {
        "top": 22,
        "left": 5,
        "width": 40,
        "height": 18
      }
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Disconnect the No. 1 water by-pass hose from the water by-pass pipe.",
        "(b) Disconnect the PCV hose from the cylinder block.",
        "(c) Remove the timing belt. (See pages EM-11 to 13)",
        "(d) Remove the No. 2 timing belt cover.",
        "(e) Remove the air intake chamber stay."
      ]
    },
    {
      "type": "text",
      "text": "(f) Using SST, remove the cylinder head bolts."
    },
    {
      "type": "part_number",
      "label": "SST",
      "number": "09043-38100",
      "description": ""
    },
    {
      "type": "text",
      "text": "(g) Remove the cylinder head assembly."
    },
    {
      "type": "diagram",
      "index": 2,
      "description": "Diagram showing the cylinder head bolt removal sequence numbered 1-14, with SST tool illustrated below",
      "labels": [
        "SST",
        "EM1412",
        "EM1413"
      ],
      "bbox": {
        "top": 42,
        "left": 5,
        "width": 40,
        "height": 18
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "5. REMOVE OIL FILTER"
    },
    {
      "type": "text",
      "text": "Using SST, remove the oil filter."
    },
    {
      "type": "part_number",
      "label": "SST",
      "number": "09228-44010",
      "description": ""
    },
    {
      "type": "diagram",
      "index": 3,
      "description": "Illustration showing the removal of oil filter using SST tool",
      "labels": [
        "SST"
      ],
      "bbox": {
        "top": 62,
        "left": 5,
        "width": 40,
        "height": 18
      }
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        "REMOVE OIL LEVEL GAUGE",
        "REMOVE ALTERNATOR",
        "REMOVE FUEL FILTER",
        "REMOVE FUEL HOSE SUPPORT"
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "10. REMOVE WATER BY-PASS PIPE"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Remove the two bolts from the timing belt case.",
        "(b) Remove the three bolts from the cylinder block and remove the water by-pass pipe with gasket."
      ]
    },
    {
      "type": "diagram",
      "index": 4,
      "description": "Illustration showing the removal of water by-pass pipe from the engine block",
      "labels": [
        "EM1780"
      ],
      "bbox": {
        "top": 80,
        "left": 5,
        "width": 40,
        "height": 18
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "11. REMOVE OIL PAN"
    },
    {
      "type": "text",
      "text": "(See page LU-5)"
    }
  ]
}
