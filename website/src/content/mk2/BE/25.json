    {
      "type": "heading",
      "level": 1,
      "text": "Rear Wiper Relay"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "INSPECTION OF REAR WIPER RELAY"
    },
    {
      "type": "heading",
      "level": 3,
      "text": "INSPECT RELAY OPERATION"
    },
    {
      "type": "text",
      "text": "Connect the positive (+) lead from the battery to terminal 1. Connect the negative (−) lead to terminal 4."
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) With connect the negative (+) lead from the battery to terminal 2, check that there is no continuity between terminals 1 and 3.",
        "(b) With disconnect terminal 2, check that there is no continuity between terminals 1 and 3 for 9 − 15 seconds."
      ]
    },
