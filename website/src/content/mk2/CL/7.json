    {
      "type": "heading",
      "level": 2,
      "text": "REMOVAL OF CLUTCH UNIT"
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        {
          "number": "1.",
          "title": "REMOVE TRANSMISSION (See pages MT-3, 4)",
          "content": [
            {
              "type": "notice",
              "text": "NOTE: Do not drain the transmission."
            }
          ]
        },
        {
          "number": "2.",
          "title": "REMOVE CLUTCH COVER AND DISC",
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "(a) Loosen the set bolts one turn at a time until spring tension is released.",
                "(b) Remove the set bolts, and pull off the clutch assembly."
              ]
            }
          ]
        },
        {
          "number": "3.",
          "title": "REMOVE BEARING, HUB AND FORK FROM TRANSMISSION",
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "(a) Remove the clips, and pull off the bearing and hub.",
                "(b) Remove the fork and boot."
              ]
            }
          ]
        }
      ]
    },
    {
