{
  "page_id": "SR-12",
  "section_header": "STEERING — Steering Column Assembly with Tilt Steering",
  "title": "INSTALLATION OF STEERING COLUMN ASSEMBLY",
  "content": [
    {
      "type": "text",
      "text": "(See page SR-3)"
    },
    {
      "type": "diagram",
      "index": 1,
      "description": "Illustration showing steering column and shaft installation position with hands placing the assembly",
      "labels": [],
      "bbox": {
        "top": 5,
        "left": 3,
        "width": 38,
        "height": 18
      }
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        "PLACE COLUMN AND SHAFT IN INSTALLED POSITION",
        "INSTALL COLUMN BRACKET MOUNTING NUTS BY HAND"
      ]
    },
    {
      "type": "diagram",
      "index": 2,
      "description": "Illustration showing steering column hole cover plate installation with bolts and tightening positions",
      "labels": [],
      "bbox": {
        "top": 24,
        "left": 3,
        "width": 38,
        "height": 17
      }
    },
    {
      "type": "list",
      "ordered": true,
      "start": 3,
      "items": [
        "INSTALL STEERING COLUMN HOLE COVER PLATE"
      ]
    },
    {
      "type": "text",
      "text": "Tighten the bolts."
    },
    {
      "type": "torque_spec",
      "component": "Steering column hole cover plate bolts",
      "value": "130 kg·cm (9 ft·lb, 13 N·m)"
    },
    {
      "type": "list",
      "ordered": true,
      "start": 4,
      "items": [
        "TORQUE TWO COLUMN BRACKET MOUNTING NUTS"
      ]
    },
    {
      "type": "torque_spec",
      "component": "Column bracket mounting nuts",
      "value": "250 kg·cm (18 ft·lb, 25 N·m)"
    },
    {
      "type": "list",
      "ordered": true,
      "start": 5,
      "items": [
        "INSTALL COMBINATION SWITCH AND COLUMN COVER",
        "INSTALL AIR DUCT AND INSTRUMENT LOWER PANEL"
      ]
    },
    {
      "type": "diagram",
      "index": 3,
      "description": "Illustration showing intermediate shaft with labeled parts (a), (b), (c) indicating column side and rack housing side installation",
      "labels": [
        "(c)",
        "(a)",
        "(b)"
      ],
      "bbox": {
        "top": 62,
        "left": 3,
        "width": 38,
        "height": 17
      }
    },
    {
      "type": "list",
      "ordered": true,
      "start": 7,
      "items": [
        "INSTALL INTERMEDIATE SHAFT"
      ]
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Install the column side first.",
        "(b) Install the rack housing side.",
        "(c) Install the two bolts and torque them."
      ]
    },
    {
      "type": "torque_spec",
      "component": "Intermediate shaft bolts",
      "value": "350 kg·cm (25 ft·lb, 34 N·m)"
    },
    {
      "type": "list",
      "ordered": true,
      "start": 8,
      "items": [
        "CONNECT NEGATIVE CABLE TO BATTERY"
      ]
    },
    {
      "type": "diagram",
      "index": 4,
      "description": "Illustration showing steering wheel installation with hands positioning the wheel in neutral position",
      "labels": [],
      "bbox": {
        "top": 81,
        "left": 3,
        "width": 38,
        "height": 17
      }
    },
    {
      "type": "list",
      "ordered": true,
      "start": 9,
      "items": [
        "INSTALL STEERING WHEEL"
      ]
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Position the front wheels straight ahead and install the steering wheel in the neutral position.",
        "(b) Tighten the nut."
      ]
    },
    {
      "type": "torque_spec",
      "component": "Steering wheel nut",
      "value": "350 kg·cm (25 ft·lb, 34 N·m)"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(c) Install the steering wheel pad."
      ]
    }
  ]
}
