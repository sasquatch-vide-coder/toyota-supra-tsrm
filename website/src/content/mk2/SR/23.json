{
  "page_id": "SR-23",
  "section_header": "STEERING — Power Steering",
  "title": "ASSEMBLY OF POWER STEERING PUMP",
  "content": [
    {
      "type": "reference",
      "text": "(See page SR-19)"
    },
    {
      "type": "diagram",
      "index": 1,
      "description": "Power steering pump assembly showing spring and flow control valve installation location",
      "labels": [
        "Flow control valve location",
        "Spring location"
      ],
      "bbox": {
        "top": 4,
        "left": 2,
        "width": 48,
        "height": 18
      },
      "reference_number": "Z3665 Z3666"
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        {
          "number": "1",
          "heading": "INSTALL SPRING AND FLOW CONTROL VALVE",
          "content": [
            {
              "type": "notice",
              "text": "Be sure the letter inscribed on the flow control valve matches the letter stamped on the rear of the pump body."
            },
            {
              "type": "text",
              "text": "Inscribed mark: A, B, C, D, E or F"
            }
          ]
        }
      ]
    },
    {
      "type": "diagram",
      "index": 2,
      "description": "Installation of pressure port union with tools shown",
      "labels": [
        "Pressure port union",
        "Torque wrench"
      ],
      "bbox": {
        "top": 23,
        "left": 2,
        "width": 48,
        "height": 18
      },
      "reference_number": "09801 Z3108"
    },
    {
      "type": "list",
      "ordered": true,
      "start": 2,
      "items": [
        {
          "number": "2",
          "heading": "INSTALL PRESSURE PORT UNION",
          "content": [
            {
              "type": "text",
              "text": "Install and torque the union."
            },
            {
              "type": "torque_spec",
              "component": "Pressure port union",
              "value": "700 kg-cm (51 ft·lb, 69 N·m)"
            }
          ]
        },
        {
          "number": "3",
          "heading": "INSTALL FLOW CONTROL SPRING SEAT",
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "(a) Temporarily install a suitable bolt to the spring seat.",
                "(b) Push in the bolt and install the snap ring with snap ring pliers.",
                "(c) Remove the suitable bolt."
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "diagram",
      "index": 3,
      "description": "Installing rotor shaft to front housing using a plastic hammer",
      "labels": [
        "Rotor shaft",
        "Front housing",
        "Plastic hammer"
      ],
      "bbox": {
        "top": 42,
        "left": 2,
        "width": 48,
        "height": 18
      },
      "reference_number": "SS018"
    },
    {
      "type": "list",
      "ordered": true,
      "start": 4,
      "items": [
        {
          "number": "4",
          "heading": "INSTALL ROTOR SHAFT TO FRONT HOUSING",
          "content": [
            {
              "type": "text",
              "text": "Install the rotor shaft into the front housing by tapping it in with a plastic hammer."
            }
          ]
        },
        {
          "number": "5",
          "heading": "INSTALL SNAP RING",
          "content": [
            {
              "type": "text",
              "text": "Using snap ring pliers, install the snap ring to the front housing."
            }
          ]
        }
      ]
    },
    {
      "type": "diagram",
      "index": 4,
      "description": "Installing oil seal using SST tool and hammer",
      "labels": [
        "SST",
        "Oil seal",
        "Hammer"
      ],
      "bbox": {
        "top": 61,
        "left": 2,
        "width": 48,
        "height": 18
      },
      "reference_number": "Z3004"
    },
    {
      "type": "list",
      "ordered": true,
      "start": 6,
      "items": [
        {
          "number": "6",
          "heading": "INSTALL OIL SEAL",
          "content": [
            {
              "type": "list",
              "ordered": false,
              "items": [
                "(a) Apply a light coat of MP grease to a new oil seal lip.",
                "(b) Using SST and a hammer, install the oil seal."
              ]
            },
            {
              "type": "part_number",
              "label": "SST",
              "number": "09608-30012 (09608-04030)",
              "description": "Oil seal installer"
            }
          ]
        }
      ]
    },
    {
      "type": "diagram",
      "index": 5,
      "description": "Installing O-ring, straight pins, and cam ring with hand showing alignment of fluid passages",
      "labels": [
        "O-ring",
        "Straight pins",
        "Cam ring",
        "Fluid passages"
      ],
      "bbox": {
        "top": 80,
        "left": 2,
        "width": 48,
        "height": 18
      },
      "reference_number": "88520"
    },
    {
      "type": "list",
      "ordered": true,
      "start": 7,
      "items": [
        {
          "number": "7",
          "heading": "INSTALL O-RING"
        },
        {
          "number": "8",
          "heading": "INSTALL STRAIGHT PINS"
        },
        {
          "number": "9",
          "heading": "INSTALL CAM RING",
          "content": [
            {
              "type": "text",
              "text": "Align the fluid passages of the cam ring and front housing, and install the cam ring."
            }
          ]
        }
      ]
    }
  ]
}
