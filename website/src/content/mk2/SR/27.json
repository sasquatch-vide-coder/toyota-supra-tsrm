        {
          "number": "2.",
          "heading": "DISCONNECT TIE ROD END",
          "substeps": [
            {
              "label": "(a)",
              "text": "Remove the cotter pin and nut holding the knuckle arm to the tie rod."
            },
            {
              "label": "(b)",
              "text": "Using SST, disconnect the knuckle arm from the tie rod.",
              "part_number": "SST 09611-22012"
