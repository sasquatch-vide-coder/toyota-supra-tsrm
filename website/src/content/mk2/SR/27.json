          ]
        },
        {
          "number": "3.",
          "heading": "DISCONNECT RETURN LINE AND PRESSURE LINE",
          "text": "Using SST, disconnect return and pressure lines. Use a container to catch the power steering fluid.",
          "part_number": "SST 09631-22020"
        },
        {
          "number": "4.",
          "heading": "REMOVE GEAR HOUSING ASSEMBLY",
          "substeps": [
            {
              "label": "(a)",
              "text": "Remove the gear housing bracket set bolts."
            },
            {
              "label": "(b)",
              "text": "Remove the housing assembly."
            }
          ]
        }
      ]
