{
  "page_id": "MT-15",
  "section_header": "MANUAL TRANSMISSION — W58 Transmission",
  "title": "MANUAL TRANSMISSION — W58 Transmission",
  "content": [
    {
      "type": "heading",
      "level": 2,
      "text": "2. CHECK OIL CLEARANCE OF FIRST GEAR"
    },
    {
      "type": "text",
      "text": "Using a dial indicator, measure the oil clearance between the gear and inner race with the needle roller bearing installed."
    },
    {
      "type": "table",
      "headers": [
        "Specification",
        "Value (mm)",
        "Value (in.)"
      ],
      "rows": [
        [
          "Standard clearance:",
          "0.009 — 0.060 mm",
          "(0.0004 — 0.0024 in.)"
        ],
        [
          "Maximum clearance:",
          "0.15 mm",
          "(0.0059 in.)"
        ]
      ]
    },
    {
      "type": "text",
      "text": "If the clearance exceeds the limit, replace the gear, inner race and needle roller bearing."
    },
    {
      "type": "diagram",
      "index": 1,
      "description": "Illustration showing measurement of first gear oil clearance using a dial indicator on the gear assembly with needle roller bearing",
      "labels": [
        "Dial indicator",
        "First gear",
        "Inner race",
        "Needle roller bearing"
      ],
      "bbox": {
        "top": 4,
        "left": 2,
        "width": 46,
        "height": 18
      },
      "reference": "WM0061"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "3. CHECK OIL CLEARANCE OF SECOND AND COUNTER FIFTH GEAR"
    },
    {
      "type": "text",
      "text": "Using a dial indicator, measure the oil clearance between the gear and output shaft with the needle roller bearing installed."
    },
    {
      "type": "table",
      "headers": [
        "Specification",
        "Value (mm)",
        "Value (in.)"
      ],
      "rows": [
        [
          "Standard clearance:",
          "",
          ""
        ],
        [
          "2nd gear",
          "0.009 — 0.060 mm",
          "(0.0004 — 0.0024 in.)"
        ],
        [
          "5th gear",
          "0.009 — 0.062 mm",
          "(0.0004 — 0.0024 in.)"
        ],
        [
          "Maximum clearance:",
          "0.15 mm",
          "(0.0059 in.)"
        ]
      ]
    },
    {
      "type": "text",
      "text": "If the clearance exceeds the limit, replace the gear, output shaft and needle roller bearing."
    },
    {
      "type": "diagram",
      "index": 2,
      "description": "Illustration showing measurement of second and counter fifth gear oil clearance using a dial indicator on the gear and output shaft assembly",
      "labels": [
        "Dial indicator",
        "Gear",
        "Output shaft",
        "Needle roller bearing"
      ],
      "bbox": {
        "top": 23,
        "left": 2,
        "width": 46,
        "height": 18
      },
      "reference": "WM0062"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "4. CHECK OIL CLEARANCE OF THIRD GEAR"
    },
    {
      "type": "text",
      "text": "Using a dial indicator, measure the oil clearance between the gear and output shaft."
    },
    {
      "type": "table",
      "headers": [
        "Specification",
        "Value (mm)",
        "Value (in.)"
      ],
      "rows": [
        [
          "Standard clearance:",
          "0.060 — 0.103 mm",
          "(0.0024 — 0.0041 in.)"
        ],
        [
          "Maximum clearance:",
          "0.20 mm",
          "(0.0079 in.)"
        ]
      ]
    },
    {
      "type": "text",
      "text": "If the clearance exceeds the limit, replace the gear and output shaft."
    },
    {
      "type": "diagram",
      "index": 3,
      "description": "Illustration showing measurement of third gear oil clearance using a dial indicator on the gear and output shaft",
      "labels": [
        "Dial indicator",
        "Third gear",
        "Output shaft"
      ],
      "bbox": {
        "top": 42,
        "left": 2,
        "width": 46,
        "height": 18
      },
      "reference": "WM0063"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "5. INSPECT SYNCHRONIZER RINGS"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        {
          "label": "(a)",
          "text": "Turn the ring and push it in to check the braking action."
        }
      ]
    },
    {
      "type": "diagram",
      "index": 4,
      "description": "Illustration showing hands turning and pushing synchronizer ring to check braking action",
      "labels": [
        "Synchronizer ring",
        "Hand turning ring",
        "Hand pushing ring"
      ],
      "bbox": {
        "top": 61,
        "left": 2,
        "width": 46,
        "height": 18
      },
      "reference": "WM0064"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        {
          "label": "(b)",
          "text": "Measure the clearance between the synchronizer ring back and the gear spline end."
        }
      ]
    },
    {
      "type": "table",
      "headers": [
        "Specification",
        "Value (mm)",
        "Value (in.)"
      ],
      "rows": [
        [
          "Standard clearance:",
          "0.7 — 1.7 mm",
          "(0.028 — 0.067 in.)"
        ],
        [
          "Minimum clearance:",
          "0.5 mm",
          "(0.020 in.)"
        ]
      ]
    },
    {
      "type": "text",
      "text": "If the clearance is less than the limit, replace the synchronizer ring."
    },
