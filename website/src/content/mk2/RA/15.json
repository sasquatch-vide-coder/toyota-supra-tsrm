  "section_header": "REAR AXLE AND SUSPENSION — Rear Drive Shaft",
  "title": "INSPECTION OF REAR DRIVE SHAFT COMPONENTS / ASSEMBLY OF REAR DRIVE SHAFT",
  "content": [
    {
      "type": "heading",
      "level": 1,
      "text": "INSPECTION OF REAR DRIVE SHAFT COMPONENTS"
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        "AFTER REMOVAL CHECK BOOTS FOR DAMAGE",
        "CLEAN ALL PARTS",
        "CHECK ALL PARTS FOR CRACKS, WEAR OR DAMAGE AND REPLACE AS NECESSARY"
      ]
    },
    {
      "type": "heading",
      "level": 1,
      "text": "ASSEMBLY OF REAR DRIVE SHAFT"
    },
    {
      "type": "text",
      "text": "(See page RA-12)"
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        {
          "step": "1",
          "text": "ASSEMBLE NEW CLAMPS ONTO DRIVE SHAFT"
        }
      ]
    },
    {
      "type": "diagram",
      "index": 1,
      "description": "Illustration showing clamps being assembled onto drive shaft",
      "labels": [],
      "bbox": {
        "top": 22,
        "left": 6,
        "width": 23,
        "height": 15
      },
      "figure_number": "RA0058"
    },
    {
      "type": "list",
      "ordered": true,
      "start": 2,
      "items": [
        {
          "step": "2",
          "text": "ASSEMBLE BOOT ONTO DRIVE SHAFT",
          "substeps": [
            {
              "type": "caution",
              "text": "Wrap the shaft serrations with vinyl tape so as to prevent damage to the boot."
            },
            {
              "label": "(a)",
              "text": "Place the outboard and inboard boots and new clamps on the shaft."
            }
          ]
        }
      ]
    },
    {
      "type": "diagram",
      "index": 2,
      "description": "Illustration showing hand wrapping shaft with tape before installing boot",
      "labels": [
        "Tape"
      ],
      "bbox": {
        "top": 40,
        "left": 6,
        "width": 23,
        "height": 15
      },
      "figure_number": "24804"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        {
          "label": "(b)",
          "text": "Install a new snap ring."
        }
      ]
    },
    {
      "type": "diagram",
      "index": 3,
      "description": "Illustration showing installation of snap ring onto shaft",
      "labels": [],
      "bbox": {
        "top": 58,
        "left": 6,
        "width": 23,
        "height": 15
      },
      "figure_number": "RA0059"
    },
    {
      "type": "list",
      "ordered": true,
      "start": 3,
      "items": [
        {
          "step": "3",
          "text": "INSTALL OUTBOARD JOINT INNER RACE",
          "substeps": [
            {
              "label": "(a)",
              "text": "Place the cage onto shaft."
            }
          ]
        }
      ]
    },
    {
      "type": "notice",
      "text": "The larger diameter end should face toward the outboard side."
    },
    {
      "type": "diagram",
