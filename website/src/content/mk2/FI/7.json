{
  "page_id": "FI-7",
  "section_header": "EFI SYSTEM — Inspection Precautions",
  "title": "FUEL SYSTEM",
  "content": [
    {
      "type": "diagram",
      "index": 1,
      "description": "Disconnecting high fuel pressure line showing plug removal",
      "labels": [
        "Plug"
      ],
      "bbox": {
        "top": 4,
        "left": 4,
        "width": 38,
        "height": 18
      },
      "reference": "F10818 / F0421"
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        {
          "number": "1",
          "text": "When disconnecting high fuel pressure line the connection, a large amount of gasoline will come out, so observe the following procedure.",
          "subitems": [
            {
              "letter": "a",
              "text": "Put a container under the connection."
            },
            {
              "letter": "b",
              "text": "Slowly loosen the connection."
            },
            {
              "letter": "c",
              "text": "Disconnect the connection."
            },
            {
              "letter": "d",
              "text": "Plug the connection with a rubber plug."
            }
          ]
        }
      ]
    },
    {
      "type": "diagram",
      "index": 2,
      "description": "Union bolt type connection showing new gasket placement",
      "labels": [
        "New Gasket"
      ],
      "bbox": {
        "top": 22,
        "left": 4,
        "width": 38,
        "height": 18
      },
      "reference": "F10857 / F1006"
    },
    {
      "type": "list",
      "ordered": true,
      "start": 2,
      "items": [
        {
          "number": "2",
          "text": "When connecting the flare nut or union bolt on the high pressure pipe union, observe the following procedure.",
          "sections": [
            {
              "heading": "[Union bolt type]",
              "subitems": [
                {
                  "letter": "a",
                  "text": "Always use a new gasket."
                },
                {
                  "letter": "b",
                  "text": "First tighten the union bolt by hand."
                },
                {
                  "letter": "c",
                  "text": "Then tighten the bolt to the specified torque."
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "torque_spec",
      "component": "Union bolt",
      "value": "300 kg-cm (22 ft-lb, 29 N·m)"
    },
    {
      "type": "diagram",
      "index": 3,
      "description": "Flare nut type connection showing tightening procedure",
      "labels": [],
      "bbox": {
        "top": 40,
        "left": 4,
        "width": 38,
        "height": 18
      },
      "reference": "F10102"
    },
    {
      "type": "text",
      "text": "[Flare nut type]",
      "subitems": [
        {
          "letter": "a",
          "text": "Apply a thin coat of oil to the flare and first tighten the flare nut by hand."
        },
        {
          "letter": "b",
          "text": "Then tighten the nut to the specified torque."
        }
      ]
    },
    {
      "type": "torque_spec",
      "component": "Flare nut",
      "value": "350 kg-cm (25 ft-lb, 34 N·m)"
    },
    {
      "type": "diagram",
      "index": 4,
      "description": "O-Ring installation showing correct and wrong orientation for delivery pipe and grommet",
      "labels": [
        "O-Ring",
        "Delivery Pipe",
        "CORRECT",
        "Injector",
        "Grommet",
        "WRONG"
      ],
      "bbox": {
        "top": 58,
        "left": 4,
        "width": 38,
        "height": 18
      },
      "reference": "F10973"
    },
    {
      "type": "list",
      "ordered": true,
      "start": 3,
      "items": [
        {
          "number": "3",
          "text": "Take the following precautions when removing and installing the injectors.",
          "subitems": [
            {
              "letter": "a",
              "text": "Never re-use an O-ring."
            },
            {
              "letter": "b",
              "text": "When placing an O-ring on the injector, use care not to damage it in any way."
            },
            {
              "letter": "c",
              "text": "Lubricate the O-ring with spindle oil or gasoline before installing — never use engine, gear or brake oil."
            }
          ]
        }
      ]
    },
    {
      "type": "diagram",
      "index": 5,
      "description": "Injector installation showing O-Ring placement on injector, insulator, delivery pipe, grommet and IN Manifold",
      "labels": [
        "O-Ring",
        "Injector",
        "Delivery Pipe",
        "Insulator",
        "Grommet",
        "IN Manifold"
      ],
      "bbox": {
        "top": 76,
        "left": 4,
        "width": 38,
        "height": 18
      },
      "reference": "F10863"
    },
    {
      "type": "list",
      "ordered": true,
      "start": 4,
      "items": [
        {
          "number": "4",
          "text": "Install the injector to the delivery pipe and intake manifold as shown in the figure."
        }
      ]
    }
  ]
}
