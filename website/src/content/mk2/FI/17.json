{
  "page_id": "FI-17",
  "section_header": "EFI SYSTEM — Troubleshooting",
  "title": "SYMPTOM — HIGH ENGINE IDLE SPEED (NO DROP)",
  "content": [
    {
      "type": "flowchart",
      "description": "Troubleshooting flowchart for high engine idle speed with no drop. Shows sequential diagnostic steps with decision branches marked as OK, BAD, Normal code, or Malfunction code(s)",
      "bbox": {
        "top": 5,
        "left": 10,
        "width": 85,
        "height": 90
      },
      "steps": [
        {
          "step": 1,
          "action": "CHECK ACCELERATOR LINKAGE",
          "outcomes": [
            {
              "result": "OK",
              "next_step": 2
            },
            {
              "result": "BAD",
              "issue": "Linkage — stuck dash pot system"
            }
          ]
        },
        {
          "step": 2,
          "action": "CHECK DIAGNOSIS SYSTEM",
          "reference": "See page FI-22",
          "note": "Check for output of diagnostic code.",
          "outcomes": [
            {
              "result": "Normal code",
              "next_step": 3
            },
            {
              "result": "Malfunction code(s)",
              "issue": "Diagnostic code(s)",
              "reference": "See page FI-25"
            }
          ]
        },
        {
          "step": 3,
          "action": "CHECK ISC SYSTEM",
          "outcomes": [
            {
              "result": "OK",
              "next_step": 4
            },
            {
              "result": "BAD",
              "issues": [
                "1. Wiring connection (Air con, Throttle position sensor — ECU)",
                "2. ISC valve",
                "3. Air conditioner switch"
              ]
            }
          ]
        },
        {
          "step": 4,
          "action": "CHECK THROTTLE POSITION SENSOR",
          "outcomes": [
            {
              "result": "OK",
              "next_step": 5
            },
            {
              "result": "BAD",
              "issue": "Throttle body"
            }
          ]
        },
        {
          "step": 5,
          "action": "CHECK FUEL PRESSURE",
          "reference": "See page FI-45",
          "outcomes": [
            {
              "result": "OK",
              "next_step": 6
            },
            {
              "result": "BAD",
              "issue": "Fuel pressure regulator — high pressure"
            }
          ]
        },
        {
          "step": 6,
          "action": "CHECK COLD START INJECTOR",
          "reference": "See page FI-49",
          "outcomes": [
            {
              "result": "OK",
              "next_step": 7
            },
            {
              "result": "BAD",
              "issue": "Cold start injector — leakage"
            }
          ]
        },
        {
          "step": 7,
          "action": "CHECK INJECTORS",
          "reference": "See page FI-53",
          "outcomes": [
            {
              "result": "OK",
              "next_step": 8
            },
            {
              "result": "BAD",
              "issue": "Injectors — leakage, injection quantity"
            }
          ]
        },
        {
          "step": 8,
          "action": "CHECK EFI ELECTRONIC CIRCUIT USING VOLT/OHMMETER",
          "outcomes": [
            {
              "result": "OK",
              "note": "End of flowchart"
            },
            {
              "result": "BAD",
              "issues": [
                "1. Wiring connection",
                "2. Power to ECU",
                "   (1) Fusible link",
                "   (2) EFI relay No. 2 main relay",
                "3. Air flow meter",
                "4. Water temp. sensor",
                "5. Air temp. sensor",
                "6. Injection signal circuit",
                "   (1) Injector wirings",
                "   (2) Resistor",
                "   (3) ECU"
              ]
            }
          ]
        }
      ]
    }
  ]
}
