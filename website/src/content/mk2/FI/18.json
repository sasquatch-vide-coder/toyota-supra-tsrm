{
  "page_id": "FI-18",
  "section_header": "EFI SYSTEM — Troubleshooting",
  "title": "SYMPTOM — ENGINE BACKFIRES-Lean Fuel Mixture",
  "content": [
    {
      "type": "diagram",
      "index": 1,
      "description": "Troubleshooting flowchart for engine backfires with lean fuel mixture, showing sequential diagnostic steps with BAD/OK decision points",
      "bbox": {
        "top": 8,
        "left": 5,
        "width": 90,
        "height": 90
      },
      "labels": []
    },
    {
      "type": "flowchart_step",
      "step": 1,
      "action": "CHECK DIAGNOSIS SYSTEM",
      "details": "Check for output of diagnostic code.\n(See page FI-22)",
      "if_normal": "Normal code",
      "if_malfunction": {
        "result": "Malfunction code(s)",
        "action": "Diagnostic code(s)\n(See page FI-25)"
      }
    },
    {
      "type": "flowchart_step",
      "step": 2,
      "action": "CHECK FOR VACUUM LEAKS IN AIR INTAKE LINE",
      "if_ok": "OK",
      "if_bad": {
        "result": "BAD",
        "checks": [
          "1. Oil filler cap",
          "2. Oil level gauge",
          "3. Hose connections",
          "4. PCV hoses",
          "5. EGR system — EGR valve stays open"
        ]
      }
    },
    {
      "type": "flowchart_step",
      "step": 3,
      "action": "CHECK IGNITION TIMING",
      "details": "1. Short both terminals of the\n   Check connector.\n2. Check ignition timing.\n   STD: 10° BTDC\n   (w/short terminals of the\n   check connector)",
      "if_ok": "OK",
      "if_bad": {
        "result": "BAD",
        "action": "Ignition system (See page IG-2)"
      }
    },
    {
      "type": "flowchart_step",
      "step": 4,
      "action": "CHECK COLD START INJECTOR",
      "details": "(See page FI-49)",
      "if_ok": "OK",
      "if_bad": {
        "result": "BAD",
        "checks": [
          "1. Cold start injector",
          "2. Start injector time switch\n   (See page FI-71)"
        ]
      }
    },
    {
      "type": "flowchart_step",
      "step": 5,
      "action": "CHECK FUEL PRESSURE",
      "details": "(See page FI-45)",
      "if_ok": "OK",
      "if_bad": {
        "result": "BAD",
        "checks": [
          "1. Fuel pump (See page FI-44)",
          "2. Fuel filter",
          "3. Fuel pressure regulator (See page FI-52)"
        ]
      }
    },
    {
      "type": "flowchart_step",
      "step": 6,
      "action": "CHECK INJECTORS",
      "details": "(See page FI-53)",
      "if_ok": "OK",
      "if_bad": {
        "result": "BAD",
        "action": "Injectors — clogged"
      }
    },
    {
      "type": "flowchart_step",
      "step": 7,
      "action": "CHECK EFI ELECTRONIC CIRCUIT USING VOLT/OHMMETER",
      "if_bad": {
        "result": "BAD",
        "checks": [
          "1. Wiring connection",
          "2. Power to ECU\n   (1) Fusible link\n   (2) No.1 and No. 2 main relay",
          "3. Air flow meter",
          "4. Water temp. sensor",
          "5. Air temp. sensor",
          "6. Throttle position sensor",
          "7. Injection signal circuit\n   (1) Injection wirings\n   (2) Resistor\n   (3) ECU\n   (4) Fuel cut signal",
          "8. Oxygen sensor"
        ]
      }
    }
  ]
}
