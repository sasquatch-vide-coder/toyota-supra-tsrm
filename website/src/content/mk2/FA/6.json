      "type": "heading",
      "level": 2,
      "text": "DISASSEMBLY OF FRONT AXLE HUB"
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        "REMOVE DISC BRAKE CALIPER",
        "REMOVE AXLE HUB WITH DISC"
      ]
    },
    {
      "type": "heading",
      "level": 3,
      "text": "1. REMOVE DISC BRAKE CALIPER"
    },
    {
      "type": "diagram",
      "index": 2,
      "description": "Illustration showing hands removing brake caliper from knuckle assembly",
      "labels": [],
      "bbox": {
        "top": 63,
        "left": 3,
        "width": 37,
        "height": 16
      }
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Remove the caliper mounting bolts and remove caliper from the knuckle.",
        "(b) Suspend the caliper with a cord."
      ]
    },
    {
      "type": "notice",
      "text": "NOTE: Do not disconnect the brake hose."
    },
    {
      "type": "heading",
      "level": 3,
      "text": "2. REMOVE AXLE HUB WITH DISC"
    },
    {
      "type": "diagram",
      "index": 3,
      "description": "Illustration showing hands removing hub and disc assembly from axle, with grease cap, cotter pin, and lock cap visible",
      "labels": [],
      "bbox": {
        "top": 81,
        "left": 3,
        "width": 37,
        "height": 16
      }
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Remove the hub grease cap, cotter pin, lock cap, nut and axle hub.",
        "(b) Remove the hub and disc together with the outer bearing and thrust washer."
      ]
    },
    {
      "type": "notice",
      "text": "NOTE: Be careful not to drop the outer bearing."
    }
  ]
