        "left": 3,
        "width": 38,
        "height": 18
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "4. INSERT REAR CLUTCH SEQUENCE VALVE"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Install the valve spring, and the valve.",
        "(b) Install the plug into the bore.",
        "(c) Coat the pin with petroleum jelly and install it."
      ]
    },
