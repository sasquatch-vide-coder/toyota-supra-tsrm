{
  "page_id": "AT-36",
  "section_header": "AUTOMATIC TRANSMISSION — On-Vehicle Repair",
  "title": "AUTOMATIC TRANSMISSION — On-Vehicle Repair",
  "content": [
    {
      "type": "diagram",
      "index": 1,
      "description": "Oil pan with four oil tubes marked (1), (2), (3), and (4) showing installation positions",
      "labels": [
        "(1)",
        "(2)",
        "(3)",
        "(4)",
        "AT0136"
      ],
      "bbox": {
        "top": 3,
        "left": 3,
        "width": 38,
        "height": 28
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "8. INSTALL FOUR OIL TUBES"
    },
    {
      "type": "text",
      "text": "Press the tubes by hand into the positions indicated in numerical order shown."
    },
    {
      "type": "caution",
      "text": "Make sure that the oil tubes or the two magnets do not interfere with the oil pan."
    },
    {
      "type": "diagram",
      "index": 2,
      "description": "Installation of oil pan with gasket and two magnets visible",
      "labels": [
        "AT0145"
      ],
      "bbox": {
        "top": 31,
        "left": 3,
        "width": 38,
        "height": 19
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "9. INSTALL PAN WITH NEW GASKET"
    },
    {
      "type": "text",
      "text": "Be sure the pan is clean and the two magnets are in place."
    },
    {
      "type": "caution",
      "text": "Do not use gasket sealer."
    },
    {
      "type": "text",
      "text": "Tighten the bolts evenly."
    },
    {
      "type": "torque_spec",
      "component": "Pan bolts",
      "value": "45 kg-cm (39 in.-lb, 4.4 N·m)"
    },
    {
      "type": "diagram",
      "index": 3,
      "description": "Installation of drain plug into oil pan",
      "labels": [
        "AT0141"
      ],
      "bbox": {
        "top": 51,
        "left": 3,
        "width": 38,
        "height": 19
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "10. INSTALL DRAIN PLUG"
    },
    {
      "type": "text",
      "text": "Torque the drain plug."
    },
    {
      "type": "torque_spec",
      "component": "Drain plug",
      "value": "205 kg-cm (15 ft-lb, 20 N·m)"
    },
    {
      "type": "diagram",
      "index": 4,
      "description": "Filling transmission with ATF fluid through dipstick tube using funnel",
      "labels": [
        "AT0142"
      ],
      "bbox": {
        "top": 71,
        "left": 3,
        "width": 38,
        "height": 19
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "11. FILL TRANSMISSION WITH ATF"
    },
    {
      "type": "text",
      "text": "Add only about four quarts of ATF."
    },
    {
      "type": "caution",
      "text": "Do not overfill."
    },
    {
      "type": "text",
      "text": "Fluid type: ATF DEXRON® II"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "12. CHECK FLUID LEVEL"
    },
    {
      "type": "text",
      "text": "(See page MA-13)"
    },
    {
      "type": "heading",
      "level": 1,
      "text": "REMOVAL OF THROTTLE CABLE"
    },
    {
      "type": "diagram",
      "index": 5,
      "description": "Throttle cable connection at air cleaner and cylinder head cover",
      "labels": [
        "AT0881"
      ],
      "bbox": {
        "top": 90,
        "left": 3,
        "width": 38,
        "height": 19
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "1. REMOVAL AIR CLEANER"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "2. DISCONNECT THROTTLE CABLE"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Disconnect the cable from the bracket on the cylinder head cover.",
        "(b) Disconnect the cable from the throttle linkage."
      ]
    }
  ]
}
