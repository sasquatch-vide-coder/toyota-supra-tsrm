    {
      "type": "heading",
      "level": 2,
      "text": "INSTALLATION OF PARKING LOCK PAWL"
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        "INSTALL PARKING LOCK PAWL AND PARKING PAWL PIVOT PIN",
        "INSTALL PIVOT SPRING"
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "INSTALL PARKING LOCK PAWL BRACKET",
      "number": 3
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        "(a) Push lock rod fully forward.",
        "(b) Install two bolts finger tight.",
        "(c) Check that the parking lock pawl operates smoothly.",
        "(d) Torque the bolts."
      ]
    },
    {
      "type": "torque_spec",
      "component": "Parking lock pawl bracket bolts",
      "value": "75 kg-cm (65 in.-lb, 7.4 N·m)"
    },
    {
      "type": "diagram",
      "index": 2,
      "description": "Parking lock pawl bracket installation showing bolt locations",
      "labels": [
        "Parking Lock Pawl Bracket",
        "Bolts"
      ],
      "bbox": {
        "top": 21,
        "left": 3,
        "width": 38,
        "height": 16
      },
      "reference": "C1900,1T"
    },
    {
      "type": "text",
      "text": "4. INSTALL VALVE BODY (See page AT-34)",
      "number": 4
    },
    {
      "type": "heading",
      "level": 2,
      "text": "REMOVAL OF EXTENSION HOUSING"
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        "RAISE VEHICLE AND POSITION PAN TO CATCH ANY FLUID THAT MAY DRIP",
        "REMOVE PROPELLER SHAFT"
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "JACK UP TRANSMISSION SLIGHTLY",
      "number": 3
    },
    {
      "type": "text",
      "text": "Securely support the transmission on a transmission jack. Lift the transmission slightly to remove weight from the rear support member."
    },
    {
      "type": "diagram",
      "index": 3,
      "description": "Transmission being supported on jack with rear support member",
      "labels": [
        "Transmission Jack",
        "Rear Support Member"
      ],
      "bbox": {
        "top": 41,
        "left": 3,
        "width": 38,
        "height": 16
      },
      "reference": "AT0783"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "DISCONNECT SPEEDOMETER CABLE",
      "number": 4
    },
    {
      "type": "text",
      "text": "Loosen the serrated retaining nut with pliers. Do not lose the felt dust protector and washer."
    },
    {
      "type": "heading",
      "level": 2,
      "text": "REMOVE SPEEDOMETER DRIVEN GEAR",
      "number": 5
    },
    {
      "type": "text",
      "text": "Remove one bolt and locking tab. Pry out the speedometer driven gear with a screwdriver."
    },
    {
      "type": "diagram",
      "index": 4,
      "description": "Speedometer cable disconnection and speedometer driven gear removal showing bolt and locking tab location",
      "labels": [
        "Speedometer Cable",
        "Bolt",
        "Locking Tab",
        "Speedometer Driven Gear"
      ],
