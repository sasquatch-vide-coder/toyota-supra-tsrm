    {
      "type": "heading",
      "level": 2,
      "text": "3. REMOVE PLUG AND CUT-BACK VALVE"
    },
    {
      "type": "diagram",
      "index": 2,
      "description": "Illustration showing removal of secondary regulator valve and spring, with bolt locations and cover plate",
      "labels": [
        "Bolt",
        "Cover plate",
        "Secondary regulator valve",
