      "reference": "C4398 C4399"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "4. REMOVE SECONDARY REGULATOR VALVE AND SPRING"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        {
          "label": "(a)",
          "text": "Remove one bolt from the plate over the valve and loosen the other bolt. Slowly rotate the plate to uncover the valve."
        }
      ]
    },
    {
      "type": "warning",
      "text": "WARNING: Valve is spring-loaded."
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        {
          "label": "(b)",
          "text": "Remove the valve and spring. Keep the spring with the valve."
        },
        {
          "label": "(c)",
          "text": "Remove the other bolt and remove the cover plate."
        }
      ]
    },
    {
      "type": "diagram",
      "index": 3,
      "description": "Illustration showing removal of throttle cam from valve body",
      "labels": [
        "Throttle cam"
      ],
      "bbox": {
        "top": 53,
        "left": 2,
        "width": 45,
        "height": 25
      },
      "reference": "C4400 C4401"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "5. REMOVE THROTTLE CAM"
    },
    {
      "type": "diagram",
      "index": 4,
      "description": "Illustration showing removal of down-shift plug and spring with pin and sleeve",
      "labels": [
        "Pin",
        "Down-shift plug",
        "Sleeve",
        "Spring"
      ],
      "bbox": {
        "top": 78,
        "left": 2,
        "width": 45,
        "height": 25
      },
      "reference": "C4402 C4403"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "6. REMOVE DOWN-SHIFT PLUG AND SPRING"
    },
    {
      "type": "list",
      "ordered": false,
      "items": [
        {
          "label": "(a)",
          "text": "Remove the pin by pushing the down-shift plug."
        },
        {
          "label": "(b)",
          "text": "Remove the down-shift plug with the sleeve and spring."
        }
      ]
    },
    {
      "type": "diagram",
