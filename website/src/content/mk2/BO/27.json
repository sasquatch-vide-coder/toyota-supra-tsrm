            {
              "label": "(b)",
              "text": "Remove the anchor bolt."
            }
          ]
        },
        {
          "number": 2,
          "heading": "REMOVE BELT GUIDE",
          "substeps": [
            {
              "label": "(a)",
              "text": "Remove the screw."
            },
            {
              "label": "(b)",
              "text": "Pry loose one clip with a screwdriver and remove the belt guide."
            }
          ]
        },
        {
          "number": 3,
          "heading": "REMOVE CENTER PILLAR INNER GARNISH",
          "text": "Pry loose two clips with a screwdriver and remove the garnish."
        },
        {
          "number": 4,
          "heading": "REMOVE LOWER BACK PANEL COVER"
        }
      ]
    },
    {
