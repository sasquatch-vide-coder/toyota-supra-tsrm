    {
      "type": "heading",
      "level": 2,
      "text": "1. CHOOSE AN ADHESIVE SET"
    },
    {
      "type": "text",
      "text": "Use a proper adhesive set depending upon the ambient temperature."
    },
    {
      "type": "diagram",
      "index": 1,
      "description": "Graph showing Usable Time (minutes) vs Ambient Temperature (°C) for three windshield glass adhesive types (No. 15, No. 35, No. 45). The graph shows decreasing usable time as temperature increases, with each adhesive having different temperature ranges.",
      "labels": [
        "Windshield Glass",
        "Adhesive",
        "No. 15",
        "No. 35",
        "No. 45",
        "Ambient Temperature",
        "Usable Time"
      ],
      "bbox": {
        "top": 52,
        "left": 3,
        "width": 36,
        "height": 23
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "2. CHECK ADHESIVE USABLE TIME"
    },
    {
      "type": "text",
      "text": "After mixing the main and hardening agents, finish glass installation within the specified time as shown."
    },
    {
      "type": "text",
      "text": "Example:"
    },
    {
      "type": "text",
      "text": "For glass installation in ambient temperature of 25°C (77°F), apply adhesive set No. 35 within 45 minutes."
    },
    {
      "type": "diagram",
      "index": 2,
      "description": "Graph showing Hardening Time (minutes) vs Ambient Temperature (°C) for three adhesive types (No. 15, No. 35, No. 45). The graph shows decreasing hardening time as temperature increases.",
      "labels": [
        "No. 15",
        "No. 35",
        "No. 45",
        "Ambient Temperature",
        "Hardening Time"
      ],
      "bbox": {
        "top": 72,
        "left": 3,
        "width": 36,
        "height": 23
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "3. CHECK ADHESIVE HARDENING TIME"
    },
    {
      "type": "text",
      "text": "When the main and hardening agents are mixed, leak tests should be made only after the hardening time has elapsed."
    },
    {
      "type": "text",
      "text": "Example:"
    },
    {
      "type": "text",
      "text": "Hardening time for adhesive set No. 35 with ambient temperature of 25°C (77°F) is 150 minutes."
    },
    {
      "type": "caution",
      "text": "Do not drive the vehicle until at least double the hardening time has elapsed."
    }
  ]
}
