    {
      "type": "heading",
      "level": 2,
      "text": "6. INSTALL SHAFT PLATE"
    },
    {
      "type": "text",
      "text": "(a) Put on the shaft plate."
    },
    {
      "type": "diagram",
      "index": 3,
      "description": "Illustration showing SST tool being used to press in shaft plate",
      "labels": [
        "SST"
      ],
      "bbox": {
        "top": 42,
        "left": 4,
        "width": 38,
        "height": 18
      }
    },
    {
      "type": "text",
      "text": "(b) Press in SST."
    },
    {
      "type": "part_number",
      "label": "SST",
      "number": "07112-25010",
      "description": ""
    },
    {
      "type": "diagram",
      "index": 4,
      "description": "Illustration showing key being tapped into shaft groove using SST and plastic hammer",
      "labels": [
        "SST"
      ],
      "bbox": {
        "top": 61,
        "left": 4,
        "width": 38,
        "height": 18
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "7. INSTALL KEY IN SHAFT GROOVE"
    },
    {
      "type": "text",
      "text": "Using SST and a plastic hammer, tap the key lightly."
    },
    {
      "type": "part_number",
      "label": "SST",
      "number": "07114-45010",
      "description": ""
    },
    {
      "type": "text",
      "text": "Put the felt inside the bore."
    },
    {
      "type": "diagram",
      "index": 5,
      "description": "Illustration showing compressor oil being poured into compressor",
      "labels": [],
      "bbox": {
        "top": 80,
        "left": 4,
        "width": 38,
        "height": 18
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "8. POUR COMPRESSOR OIL INTO COMPRESSOR"
    },
    {
      "type": "text",
      "text": "Compressor oil: DENSO OIL 6, SUNISO No.5GS, or equivalent"
    },
    {
      "type": "text",
      "text": "Refill capacity: 10 — 20 cc (0.3 — 0.7 fl. oz.)"
    }
  ]
