{
  "page_id": "AC-36",
  "section_header": "AIR CONDITIONING SYSTEM — Condenser",
  "title": "CONDENSER",
  "content": [
    {
      "type": "text",
      "text": "(See page AC-22)"
    },
    {
      "type": "heading",
      "level": 2,
      "text": "ON-VEHICLE INSPECTION"
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        {
          "number": "1.",
          "heading": "CHECK CONDENSER FINS FOR BLOCKAGE OR DAMAGE",
          "text": "If the fins are clogged, wash them with a water and dry with compressed air.",
          "caution": {
            "type": "caution",
            "text": "Be careful not to damage the fins."
          },
          "additional_text": "If the fins are bent, straighten them with screwdriver or pliers."
        },
        {
          "number": "2.",
          "heading": "CHECK CONDENSER FITTINGS FOR LEAKAGE",
          "text": "Repair as necessary."
        }
      ]
    },
    {
      "type": "diagram",
      "index": 1,
      "description": "Illustration showing the front view of a vehicle with condenser visible behind the grille area",
      "bbox": {
        "top": 20,
        "left": 3,
        "width": 37,
        "height": 40
      }
    },
    {
      "type": "heading",
      "level": 2,
      "text": "REMOVAL OF CONDENSER"
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        {
          "number": "1.",
          "heading": "DISCHARGE REFRIGERATION SYSTEM",
          "text": "(See page AC-12)"
        },
        {
          "number": "2.",
          "heading": "REMOVE FRONT GRILLE AND HOOD LOCK BRACE"
        },
        {
          "number": "3.",
          "heading": "DISCONNECT DISCHARGE FLEXIBLE HOSE FROM CONDENSER INLET FITTING"
        },
        {
          "number": "4.",
          "heading": "DISCONNECT LIQUID LINE TUBE FROM CONDENSER OUTLET FITTING",
          "note": {
            "type": "notice",
            "text": "Cap the open fittings immediately to keep moisture out of the system."
          }
        },
        {
          "number": "5.",
          "heading": "REMOVE CONDENSER",
          "text": "Remove the four bolts."
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "INSTALLATION OF CONDENSER"
    },
    {
      "type": "list",
      "ordered": true,
      "items": [
        {
          "number": "1.",
          "heading": "INSTALL CONDENSER",
          "text": "Install the four bolts making sure the rubber cushions fit into the mounting flanges correctly."
        },
        {
          "number": "2.",
          "heading": "CONNECT LIQUID LINE TUBE AND DISCHARGE FLEXIBLE HOSE TO CONDENSER",
          "torque_specs": [
            {
              "type": "torque_spec",
              "component": "Liquid line tube",
              "value": "135 kg-cm (10 ft-lb, 13 N·m)"
            },
            {
              "type": "torque_spec",
              "component": "Discharge flexible hose",
              "value": "225 kg-cm (16 ft-lb, 22 N·m)"
            }
          ]
        },
        {
          "number": "3.",
          "heading": "INSTALL FRONT GRILLE AND HOOD LOCK BRACE"
        },
        {
          "number": "4.",
          "heading": "IF CONDENSER IS REPLACED, ADD COMPRESSOR OIL TO COMPRESSOR",
          "text": "Add 25 — 30 cc (0.8 — 1.0 fl. oz.)"
        },
        {
          "number": "5.",
          "heading": "EVACUATE, CHARGE AND TEST REFRIGERATION SYSTEM",
          "text": "(See page AC-12)"
        }
      ]
    }
  ]
}
