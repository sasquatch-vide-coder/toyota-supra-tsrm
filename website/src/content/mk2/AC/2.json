{
  "page_id": "AC-2",
  "section_header": "AIR CONDITIONING SYSTEM — Precautions, Troubleshooting",
  "title": "PRECAUTIONS",
  "content": [
    {
      "type": "list",
      "ordered": true,
      "items": [
        {
          "number": "1",
          "title": "When handling refrigerant (R-12), the following precautions should be observed:",
          "subitems": [
            {
              "label": "(a)",
              "text": "Always wear eye protection."
            },
            {
              "label": "(b)",
              "text": "Keep the refrigerant container (service drum) below 40°C (104°F)."
            },
            {
              "label": "(c)",
              "text": "Do not handle refrigerant in an enclosed area where there is an open flame."
            },
            {
              "label": "(d)",
              "text": "Discharge refrigerant slowly when purging the system."
            },
            {
              "label": "(e)",
              "text": "Be careful that the liquid refrigerant does not get on your skin."
            }
          ]
        },
        {
          "number": "2",
          "title": "If liquid refrigerant gets in the eyes or on the skin:",
          "subitems": [
            {
              "label": "(a)",
              "text": "Do not rub the eye or skin."
            },
            {
              "label": "(b)",
              "text": "Wash the area with a lot of cool water."
            },
            {
              "label": "(c)",
              "text": "Apply clean petroleum jelly to the skin."
            },
            {
              "label": "(d)",
              "text": "Rush to a physician or hospital for immediate professional treatment."
            },
            {
              "label": "(e)",
              "text": "Do not attempt to treat yourself."
            }
          ]
        },
        {
          "number": "3",
          "title": "When tubing:",
          "subitems": [
            {
              "label": "(a)",
              "text": "Apply a few drops of compressor oil to the seats of the O-ring fittings."
            },
            {
              "label": "(b)",
              "text": "Tighten the nut using two wrenches to avoid twisting the tube."
            },
            {
              "label": "(c)",
              "text": "Tighten the O-ring fitting to the specified torque."
            }
          ]
        }
      ]
    },
    {
