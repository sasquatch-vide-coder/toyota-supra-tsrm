          "number": "16",
          "title": "REMOVE OIL PAN",
          "steps": [
            {
              "letter": "(a)",
              "text": "Remove the twenty six bolts, and remove the oil pan."
            },
            {
              "letter": "(b)",
              "text": "Using SST and a brass bar, separate the oil pan from the cylinder block."
            }
          ]
