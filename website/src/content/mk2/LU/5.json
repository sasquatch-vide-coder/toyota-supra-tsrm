      "items": [
        {
          "number": "17",
          "title": "REMOVE OIL PUMP ASSEMBLY",
          "steps": [
            {
              "letter": "(a)",
              "text": "Remove the union bolt and nut and disconnect the oil pump outlet pipe."
            },
            {
              "letter": "(b)",
              "text": "Remove the oil pump mounting bolt and remove the oil pump."
            }
          ]
        }
      ]
    },
    {
      "type": "diagram",
