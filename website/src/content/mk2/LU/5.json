    {
      "type": "list",
      "ordered": true,
      "start": 18,
      "items": [
        {
          "number": "18",
          "title": "DISASSEMBLE OIL PUMP ASSEMBLY",
          "steps": [
            {
              "letter": "(a)",
              "text": "Unscrew the relief valve plug, and remove spring and relief valve."
            },
            {
              "letter": "(b)",
              "text": "Remove the five bolts, and remove oil pump cover and driven gear."
            },
            {
              "letter": "(c)",
              "text": "Remove the snap ring, spacer, drive shaft gear, key and shaft subassembly."
            }
          ]
        }
      ]
    }
